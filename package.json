{
  "name": "taskfence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TaskFence — progressive, human-controlled delegation enforced at the WebMCP tool-call boundary.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
